# Copy to .env.local (development) or set these in the production environment.
# .env* is gitignored — never commit real credentials.

# ---------------------------------------------------------------- credentials
# HTTP Basic auth guarding the whole application.
#
# Leave BOTH unset in development and the app stays open with no login prompt.
# In PRODUCTION, leaving them unset makes the app refuse to serve at all — it
# fails closed rather than exposing financial data because a variable was
# forgotten.
#
# ⚠ Basic auth is base64-encoded, NOT encrypted. Only deploy this behind TLS.
# Generate a strong password with:  openssl rand -base64 24
AUTH_USER=
AUTH_PASSWORD=

# ------------------------------------------------------------------ database
# Path to the SQLite file. Defaults to ./data/swing-society.db
# DATABASE_URL=/var/lib/swing-society/finance.db

# ------------------------------------------------------------------- backups
# Where `npm run db:backup` writes, and how many snapshots it keeps locally.
# BACKUP_DIR=./backups
# BACKUP_RETENTION=14

# ------------------------------------------------- off-machine backup storage
# Optional. When all four are set, every VERIFIED backup is uploaded here.
# Leave unset and backups stay local only — the script says so explicitly.
#
# On Fly these are set with `fly secrets set`, not in this file. Create the
# bucket with `fly storage create`, which prints the credentials once.
#
# Remote objects are NEVER deleted by the backup script. Expire old ones with a
# bucket lifecycle rule instead — automatic deletion of off-site backups is not
# something worth risking a bug in.
# S3_ENDPOINT=https://fly.storage.tigris.dev
# S3_BUCKET=swing-society-backups
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto

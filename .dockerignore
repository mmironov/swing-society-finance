# Keep the build context minimal and — critically — free of data and secrets.

node_modules
.next
dist-scripts

# THE DEVELOPMENT DATABASE MUST NEVER ENTER THE IMAGE.
# Next's file tracing follows the database path and will happily copy this file
# into .next/standalone, baking demo transactions into a production image.
# Excluding it here means the build simply never sees it.
data
*.db
*.db-shm
*.db-wal
backups

# Secrets
.env
.env.*
!.env.example

# Local tooling and history
.git
.gitignore
.claude
.vscode
*.log
.DS_Store

# Not needed to build or run
README.md
AGENTS.md
CLAUDE.md
Dockerfile
.dockerignore
compose.yaml
fly.toml
